@page "/study_sessions"
@using StudySession.Domain.Participation
@using StudySession.Domain.StudySessions
@model ListModel
@{
    ViewData["Title"] = "勉強会一覧";
}

<section class="common-container">
    <h1 class="page-title">開催予定の社内勉強会一覧</h1>
    <p class="page-lead">対面・リモートそれぞれの空き状況と、あなたの出欠を確認できます。</p>
    <hr>

    <div class="surface-panel">
        <label for="keyword" class="bold">キーワードで検索</label>
        <div class="button-row margin-top-05">
            <input id="keyword" type="text" class="search-box" placeholder="勉強会名、概要で検索" />
            <button type="button" class="btn-primary">検索</button>
        </div>
        <p class="helper-text">技術タグ検索は次フェーズで実装予定です。</p>
    </div>

    <h2 class="common-heading">検索結果</h2>
    <div class="table-scroll-wrapper">
        <table>
            <thead>
                <tr>
                    <th>開催日時</th>
                    <th>勉強会テーマ</th>
                    <th>対面枠</th>
                    <th>リモート枠</th>
                    <th>あなたの出欠</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Sessions.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="helper-text">表示する勉強会はありません。</td>
                    </tr>
                }
                else
                {
                    foreach (var session in Model.Sessions)
                    {
                        var currentStatus = session.IsAttendingOnsite == AttendanceStatus.Onsite
                            ? "対面出席"
                            : session.IsAttendingRemote == AttendanceStatus.Remote
                                ? "リモート出席"
                                : session.IsAttendingOnsite == AttendanceStatus.Absent || session.IsAttendingRemote == AttendanceStatus.Absent
                                    ? "欠席"
                                    : "未回答";

                        var badgeClass = currentStatus == "対面出席" || currentStatus == "リモート出席"
                            ? "badge-info"
                            : currentStatus == "欠席"
                                ? "badge-danger"
                                : "badge-warning";

                        var onsiteDisplay = session.Format == StudySessionFormat.RemoteOnly
                            ? "- (対象外)"
                            : $"{session.ParticipantsCountOnsite} / {session.CapacityOnsite} 名";

                        var remoteDisplay = session.Format == StudySessionFormat.OnsiteOnly
                            ? "- (対象外)"
                            : $"{session.ParticipantsCountRemote} / {session.CapacityRemote} 名";

                        var onsiteFull = session.Format != StudySessionFormat.RemoteOnly && session.CapacityOnsite > 0 && session.ParticipantsCountOnsite >= session.CapacityOnsite;
                        var remoteFull = session.Format != StudySessionFormat.OnsiteOnly && session.CapacityRemote > 0 && session.ParticipantsCountRemote >= session.CapacityRemote;

                        <tr>
                            <td>@session.StartTime.ToString("yyyy/MM/dd HH:mm")</td>
                            <td><span class="bold">@session.Title</span></td>
                            <td>
                                @if (session.Format == StudySessionFormat.RemoteOnly)
                                {
                                    <span class="color-gray">- (対象外)</span>
                                }
                                else
                                {
                                    <span>@onsiteDisplay</span>
                                    @if (onsiteFull)
                                    {
                                        <span class="color-red"> (満席)</span>
                                    }
                                }
                            </td>
                            <td>
                                @if (session.Format == StudySessionFormat.OnsiteOnly)
                                {
                                    <span class="color-gray">- (対象外)</span>
                                }
                                else
                                {
                                    <span>@remoteDisplay</span>
                                    @if (remoteFull)
                                    {
                                        <span class="color-red"> (満席)</span>
                                    }
                                }
                            </td>
                            <td><span class="badge @badgeClass">@currentStatus</span></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</section>
