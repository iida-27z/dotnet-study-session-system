<!DOCTYPE html>
<html lang="ja">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - 勉強会ポータル</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/StudySession.Web.styles.css" asp-append-version="true" />
</head>

<body>
    <a href="#main-content" class="skip-link">本文へ移動</a>
    <div class="wrapper">
        <header>
            <div class="header">
                <a asp-page="/StudySessions/List" class="link-reset"><span class="site-title">勉強会ポータル</span></a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <form method="post" asp-page="/Logout">
                        <button type="submit" class="header-btn">ログアウト</button>
                    </form>
                }
            </div>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <nav class="nav-bar" aria-label="メインナビゲーション">
                    <a class="nav-menu" asp-page="/StudySessions/List"
                       aria-current="@(ViewContext.HttpContext.Request.Path == "/study_sessions" ? "page" : null)">勉強会一覧</a>
                    <a class="nav-menu" asp-page="/StudySessions/Create"
                       aria-current="@(ViewContext.HttpContext.Request.Path == "/study_sessions/create" ? "page" : null)">勉強会作成</a>
                </nav>
            }
        </header>
        <main id="main-content" tabindex="-1">
            @RenderBody()
        </main>
        <footer>
            <div>
                <hr>
                <p class="center">2026 11/07 更新</p>
            </div>
        </footer>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
